# ============================================================================
# Environment Variables
# ============================================================================
# Set these in your host's environment settings, or in a local .env file
# DO NOT commit .env file to git - use .env.example as template
# ============================================================================

# Beds24 API Authentication
# Get your refresh token from: https://beds24.com/control2.php?pagetype=accountaccess
BEDS24_REFRESH_TOKEN=


# MCP Server Configuration
MCP_TRANSPORT=http
LOG_LEVEL=INFO

# Optional: Advanced Configuration
# CACHE_ENABLED=true
# CACHE_TTL_PROPERTIES=86400
# CACHE_TTL_BOOKINGS=300
